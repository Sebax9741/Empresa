# Dependencias
node_modules/

# Carpeta que se arma sola para publicar la web
www/

# Proyecto Android generado por Capacitor
android/

# NUNCA subir la clave de firma del APK: va en los secretos de GitHub
# (ANDROID_KEYSTORE_BASE64 y ANDROID_KEYSTORE_PASSWORD)
android-keys/
*.keystore
*.jks

# Borrador: lo que se prueba de paso y no vale la pena guardar
scratchpad/

# Las pruebas (pruebas/*.js) SÍ van al repositorio: son la red de seguridad
# de quien venga después. Lo que no va es lo que ellas escupen al correr.
pruebas/*.png
pruebas/*.jpg
pruebas/*.pdf
pruebas/*.html
pruebas/*.xlsx
pruebas/*.out

# Credenciales
*service-account*.json
.env
.env.*

# Registros que dejan los emuladores al probar en el equipo
firebase-debug.log
firestore-debug.log
*-debug.log
