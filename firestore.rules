rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config del negocio: guarda quién es el dueño (dónde viven los datos).
    // Se crea UNA sola vez: el primer usuario que inicia sesión queda como dueño.
    match /config/app {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/config/app)
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /usuarios/{ownerUid} {

      function esMiembro() {
        return request.auth != null
          && exists(/databases/$(database)/documents/usuarios/$(ownerUid)/miembros/$(request.auth.uid));
      }
      function miMembresia() {
        return get(/databases/$(database)/documents/usuarios/$(ownerUid)/miembros/$(request.auth.uid)).data;
      }
      function esAdmin() {
        return esMiembro() && miMembresia().rol == 'admin';
      }
      // .get(nombre, false) evita errores con usuarios creados antes de que
      // existiera un permiso nuevo (la clave simplemente no está en su ficha).
      function permiso(nombre) {
        return esAdmin() || (esMiembro() && miMembresia().permisos.get(nombre, false) == true);
      }

      // Créditos del negocio (datos compartidos por el equipo).
      // Anular una nota de venta borra el crédito que salió de ella, así que
      // quien pueda anular notas puede borrarlo — pero SOLO si no tiene cobros
      // registrados, que es exactamente lo que la app comprueba antes: ese
      // dinero ya está contado en la hoja de cobranza de su día.
      match /creditos/{docId} {
        allow read: if esMiembro();
        allow create: if permiso('crear');
        allow update: if permiso('editar') || permiso('pagos') || permiso('ventasEditar');
        allow delete: if permiso('borrar')
                      || (permiso('ventasAnular') && resource.data.get('abonos', []).size() == 0);
      }

      // Clientes del negocio (nombre + zona). Todos los miembros los pueden ver
      // para elegirlos al crear un crédito; solo quien tenga el permiso los edita.
      // Borrar un cliente es distinto de registrarlo o corregirlo: se lleva por
      // delante su ficha y su historial, así que va con permiso aparte
      // ("Borrar clientes"), que por defecto no lleva nadie.
      match /clientes/{docId} {
        allow read: if esMiembro();
        allow create, update: if permiso('clientes') || permiso('crear');
        allow delete: if esAdmin() || permiso('clientesBorrar');
      }

      // Hojas de cobranza: cualquier miembro del equipo puede ABRIR la hoja del
      // día (creación no destructiva; queda constancia de quién/cuándo con la
      // hora del servidor). Esto permite la apertura automática configurada por
      // el administrador para todo el equipo. El botón manual de "crear hoja"
      // se sigue mostrando solo a quien tenga el permiso 'hojaCrear'.
      // Cerrar o modificar una hoja sigue siendo solo del administrador.
      match /hojas/{fecha} {
        allow read: if esMiembro();
        allow create: if esMiembro();
        allow update, delete: if esAdmin();
      }

      // Notas de venta anuladas (el número existe pero no llegó a ser crédito).
      // Quien puede crear o editar créditos las anula; borrarlas (deshacer la
      // anulación) también.
      match /anulados/{docId} {
        allow read: if esMiembro();
        allow create, update, delete: if permiso('crear') || permiso('editar')
                                      || permiso('ventasAnular');
      }

      // Despachos (viajes de reparto) y sus pedidos, y la lista de repartidores.
      // Quien tenga el permiso "despachos" (o el administrador) los arma y edita.
      // Modificar una nota le pasa el importe nuevo a su despacho, y anularla
      // lo quita de reparto: por eso esos dos permisos también entran aquí.
      match /despachos/{docId} {
        allow read: if esMiembro();
        allow create: if permiso('despachos');
        allow update: if permiso('despachos') || permiso('ventasEditar');
        allow delete: if permiso('despachos') || permiso('ventasAnular');
      }
      match /repartidores/{docId} {
        allow read: if esMiembro();
        allow create, update, delete: if permiso('despachos');
      }

      // Catálogo de productos y movimientos de almacén (kardex). Todos los
      // miembros los leen (hacen falta para vender y para ver el stock), pero
      // solo quien tenga el permiso "productos" los toca.
      match /productos/{docId} {
        allow read: if esMiembro();
        allow create, update, delete: if permiso('productos');
      }
      // El kardex también lo escribe quien vende: cada nota de venta genera su
      // salida de almacén. Al modificar una nota se retiran sus salidas viejas
      // y se anotan las nuevas, así que quien pueda modificar o anular notas
      // tiene que poder borrarlas — pero SOLO las de venta: los ingresos de
      // mercadería y los ajustes siguen siendo cosa del almacén.
      match /kardex/{docId} {
        allow read: if esMiembro();
        allow create: if permiso('productos') || permiso('ventas') || permiso('crear');
        allow update, delete: if permiso('productos')
                              || ((permiso('ventasEditar') || permiso('ventasAnular'))
                                  && resource.data.get('motivo', '') == 'venta');
      }

      // Notas de venta emitidas. Corregirlas y anularlas son dos permisos
      // aparte; BORRARLAS de verdad, sin dejar rastro, sigue siendo solo del
      // administrador (y con el código de seguridad).
      match /notas/{docId} {
        allow read: if esMiembro();
        allow create: if permiso('ventas') || permiso('crear');
        allow update: if permiso('ventasEditar') || permiso('ventasAnular');
        allow delete: if esAdmin();
      }

      // Ajustes del negocio (por ahora: la huella del código de seguridad).
      // Todos la pueden leer para comprobar el código, pero solo el
      // administrador la puede cambiar.
      match /config/{docId} {
        allow read: if esMiembro();
        allow write: if esAdmin();
      }

      // Miembros y sus permisos
      match /miembros/{memberUid} {
        allow read: if esMiembro();
        // Bootstrap: el dueño crea su propio registro de administrador la 1ª vez
        allow create: if request.auth != null
                      && request.auth.uid == ownerUid
                      && memberUid == ownerUid
                      && request.resource.data.rol == 'admin';
        // Gestión normal: solo un administrador crea/edita/borra miembros
        allow create, update, delete: if esAdmin();
      }
    }
  }
}
